# 端口号
VITE_PORT=5666
# VITE_PORT=8001


VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# DPP模块接口地址
VITE_DPP_API_URL=/dpp

# MTP模块接口地址
VITE_MTP_API_URL=/mtp

# SMP模块接口地址
VITE_SMP_API_URL=/smp

# MEP模块接口地址(模型部署平台)
VITE_MEP_API_URL=/mep

# XAA模块接口地址(Xnet智能体)
VITE_XAA_API_URL=/xaa
# VITE_GLOB_API_URL=http://127.0.0.1:8181/api
# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

VITE_DEVTOOLS=true
