VITE_BASE=/

# 接口地址 (Login)
VITE_GLOB_API_URL=/api

# DPP模块接口地址
VITE_DPP_API_URL=/dpp

# MTP模块接口地址
VITE_MTP_API_URL=/mtp

# SMP模块接口地址
VITE_SMP_API_URL=/smp

# MEP模块接口地址(模型部署平台)
VITE_MEP_API_URL=/mep

# XAA模块接口地址(Xnet智能体)
VITE_XAA_API_URL=/xaa

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
