VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=http://192.168.10.42:30888/api

# DPP模块接口地址
VITE_DPP_API_URL=http://192.168.10.42:30888/api

# MTP模块接口地址
VITE_MTP_API_URL=http://192.168.10.42:30888/api

# SMP模块接口地址
VITE_SMP_API_URL=http://192.168.10.42:30888/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
