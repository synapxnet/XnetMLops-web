VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=http://192.168.1.156:8181/api

# DPP模块接口地址
VITE_DPP_API_URL=http://192.168.1.156:8182/api

# MTP模块接口地址
VITE_MTP_API_URL=http://192.168.1.156:8183/api

# SMP模块接口地址
VITE_SMP_API_URL=http://192.168.1.156:8185/api

# MEP模块接口地址(模型部署平台)
VITE_MEP_API_URL=http://192.168.1.156:8184/api

# XAA模块接口地址(Xnet智能体)
VITE_XAA_API_URL=http://192.168.1.156:8186/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
